# Default board configuration for RTOS builds
BOARD ?= esp32-wroom32
BOARD_CPU_HZ ?= 240000000

# ESP32 builds should use the Xtensa LX6 little-endian toolchain.
BOARD_TOOLCHAIN_PREFIX ?= xtensa-esp32-elf-
BOARD_CC ?= $(BOARD_TOOLCHAIN_PREFIX)gcc
BOARD_AR ?= $(BOARD_TOOLCHAIN_PREFIX)ar
BOARD_OBJCOPY ?= $(BOARD_TOOLCHAIN_PREFIX)objcopy

# Flash settings
BOARD_FLASH_PORT ?= /dev/ttyUSB0
BOARD_FLASH_BAUD ?= 460800

BOARD_FLASH_OFFSET ?= 0x10000
