# STM32F769I-DISCO board configuration for saramOS
BOARD := stm32f769i-disco
# Must match SYSCLK_HZ in src/hal/stm32f769i-disco/hal_sys.c (216 MHz, raised
# from the default to match Zephyr's SDRAM timing reference -- see that
# file's comment). BOARD_CPU_MHZ feeds engine/libttak's DWT cycle-counter
# timing (see os/default/Makefile's libttak target and
# engine/libttak/include/ttak/timing/timing.h's TTAK_DWT_MHZ) -- getting
# this wrong doesn't break the build, it just makes ttak_get_tick_count()
# silently report the wrong elapsed time.
BOARD_CPU_HZ := 216000000
BOARD_CPU_MHZ := 216

# ARM Cortex-M7 toolchain
BOARD_TOOLCHAIN_PREFIX := arm-none-eabi-
BOARD_CC := $(BOARD_TOOLCHAIN_PREFIX)gcc
BOARD_AR := $(BOARD_TOOLCHAIN_PREFIX)ar
BOARD_OBJCOPY := $(BOARD_TOOLCHAIN_PREFIX)objcopy
BOARD_SIZE := $(BOARD_TOOLCHAIN_PREFIX)size

BOARD_CFLAGS := -mcpu=cortex-m7 -mthumb -mfloat-abi=hard -mfpu=fpv5-sp-d16 \
                -ffunction-sections -fdata-sections -Wall -Wextra -Os -g \
                -DSTM32F769xx -DHELLOWORLD_DEPLOY_RUNNER -DEMBEDDED_BAREMETAL=1 \
                -DBOARD_STM32F769I_DISCO

BOARD_LDFLAGS := -mcpu=cortex-m7 -mthumb -mfloat-abi=hard -mfpu=fpv5-sp-d16 \
                 -nostartfiles -specs=nano.specs -specs=nosys.specs \
                 -Wl,--gc-sections

BOARD_LOAD_ADDR := 0x08000000

# Flash settings (ST-Link V2 via OpenOCD)
BOARD_FLASH_INTERFACE := stlink
BOARD_FLASH_TARGET := stm32f7x
