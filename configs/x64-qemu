# x64 QEMU configuration for saramOS
BOARD := x64-qemu
BOARD_CPU_HZ := 3000000000

# Toolchain settings
BOARD_TOOLCHAIN_PREFIX := 
BOARD_CC := $(BOARD_TOOLCHAIN_PREFIX)x86_64-elf-gcc
BOARD_AR := $(BOARD_TOOLCHAIN_PREFIX)ar
BOARD_OBJCOPY := $(BOARD_TOOLCHAIN_PREFIX)objcopy

BOARD_CFLAGS := -ffreestanding -mcmodel=kernel -mno-red-zone -fno-pie -fno-stack-protector -Wall -Wextra =z max-page-size=0x1000

BOARD_LDFLAGS := -nostdlib -static -no-pie

# Default Load Address
BOARD_LOAD_ADDR := 0x100000
